{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/types/breadboard/v1/schema.json",
  "title": "Breadboard v1",
  "description": "Configureer en bekijk een schakeling met componenten, contactpunten en gekleurde draden.",
  "type": "object",
  "required": [
    "configuratie"
  ],
  "additionalProperties": false,
  "properties": {
    "configuratie": {
      "type": "object",
      "title": "Breadboard-configuratie",
      "description": "De bewerkbare tekening. Courses slaat de JSON uit de configuratie-iframe op en geeft deze bij weergave als waarde mee.",
      "format": "learning-tool-config-url",
      "x-config-url": {
        "url": "/types/breadboard/v1/?mode=config",
        "width": 1120,
        "height": 760,
        "valueType": "application/json",
        "messageType": "learning-tool:config-change"
      },
      "additionalProperties": false,
      "properties": {
        "canvasWidth": {
          "type": "integer",
          "title": "Canvasbreedte (px)",
          "description": "Breedte van de tekenruimte.",
          "minimum": 480,
          "maximum": 2400,
          "default": 1000
        },
        "canvasHeight": {
          "type": "integer",
          "title": "Canvashoogte (px)",
          "description": "Hoogte van de tekenruimte.",
          "minimum": 320,
          "maximum": 1800,
          "default": 620
        },
        "showPinsInResult": {
          "type": "boolean",
          "title": "Contactpinnen tonen",
          "description": "Toont de gekleurde contactrondjes in het eindresultaat. In de editor blijven ze altijd zichtbaar.",
          "default": true
        },
        "showExportButtonInResult": {
          "type": "boolean",
          "title": "Afbeelding opslaan toestaan",
          "description": "Toont in de weergavemodus een knop waarmee de gebruiker het breadboard als PNG-afbeelding kan opslaan. In de editor is deze knop altijd beschikbaar.",
          "default": false
        },
        "components": {
          "type": "array",
          "title": "Componenten",
          "description": "Onderdelen en hun positie op de tekening.",
          "items": {
            "type": "object",
            "title": "Geplaatst element",
            "required": [
              "id",
              "kind",
              "name",
              "x",
              "y",
              "locked"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "title": "ID",
                "description": "Unieke sleutel van dit element."
              },
              "kind": {
                "type": "string",
                "title": "Type",
                "description": "Soort component.",
                "enum": [
                  "breadboard",
                  "arduino",
                  "component",
                  "fritzing"
                ]
              },
              "name": {
                "type": "string",
                "title": "Naam",
                "description": "Naam die in de elementenlijst wordt getoond."
              },
              "x": {
                "type": "number",
                "title": "X-positie",
                "description": "Horizontale positie in pixels."
              },
              "y": {
                "type": "number",
                "title": "Y-positie",
                "description": "Verticale positie in pixels."
              },
              "layer": {
                "type": "integer",
                "title": "Laag",
                "description": "Bepaalt welke componenten boven andere componenten worden getekend. Breadboards gebruiken standaard een lagere laag."
              },
              "rotation": {
                "type": "integer",
                "title": "Rotatie",
                "description": "Draaiing van het component met de klok mee, in stappen van 90 graden.",
                "enum": [
                  0,
                  90,
                  180,
                  270
                ],
                "default": 0
              },
              "locked": {
                "type": "boolean",
                "title": "Vergrendeld",
                "description": "Vergrendelt slepen en wijzigen van de positie."
              },
              "showLabel": {
                "type": "boolean",
                "title": "Label tonen",
                "description": "Toont de naam van het component op de stage.",
                "default": false
              },
              "partId": {
                "type": "string",
                "title": "Fritzing-onderdeel",
                "description": "Pad naar de onderdeeldefinitie binnen de Fritzing-bibliotheek."
              },
              "image": {
                "type": "string",
                "title": "Breadboard-afbeelding",
                "description": "Relatief pad naar de SVG-afbeelding van het Fritzing-onderdeel."
              },
              "width": {
                "type": "number",
                "title": "Breedte onderdeel",
                "description": "Weergavebreedte van het onderdeel in pixels."
              },
              "height": {
                "type": "number",
                "title": "Hoogte onderdeel",
                "description": "Weergavehoogte van het onderdeel in pixels."
              },
              "pins": {
                "type": "array",
                "title": "Contactpunten onderdeel",
                "description": "De uit de Fritzing-definitie afgeleide aansluitpunten.",
                "items": {
                  "type": "object",
                  "title": "Contactpunt",
                  "required": ["id", "label", "x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {"type": "string", "title": "ID", "description": "Fritzing-ID van het contactpunt."},
                    "label": {"type": "string", "title": "Naam", "description": "Leesbare naam van het contactpunt."},
                    "x": {"type": "number", "title": "X-positie", "description": "Horizontale positie binnen het onderdeel."},
                    "y": {"type": "number", "title": "Y-positie", "description": "Verticale positie binnen het onderdeel."}
                  }
                }
              }
            }
          }
        },
        "wires": {
          "type": "array",
          "title": "Draden",
          "description": "Verbindingen tussen twee contactpunten, inclusief eventuele knikpunten.",
          "items": {
            "type": "object",
            "title": "Draad",
            "required": [
              "id",
              "from",
              "to",
              "color",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "title": "ID",
                "description": "Unieke sleutel van de draad."
              },
              "name": {
                "type": "string",
                "title": "Naam",
                "description": "Herkenbare naam of label voor de draad."
              },
              "from": {
                "type": "string",
                "title": "Van contactpunt",
                "description": "ID van het eerste contactpunt."
              },
              "to": {
                "type": "string",
                "title": "Naar contactpunt",
                "description": "ID van het tweede contactpunt."
              },
              "color": {
                "type": "string",
                "title": "Kleur",
                "description": "Weergavekleur van de draad.",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "showLabel": {
                "type": "boolean",
                "title": "Label tonen",
                "description": "Toont de naam van de draad op de stage.",
                "default": false
              },
              "points": {
                "type": "array",
                "title": "Knikpunten",
                "description": "Tussenpunten van de draad in canvascoördinaten.",
                "items": {
                  "type": "object",
                  "title": "Knikpunt",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "title": "X",
                      "description": "Horizontale positie."
                    },
                    "y": {
                      "type": "number",
                      "title": "Y",
                      "description": "Verticale positie."
                    }
                  }
                }
              }
            }
          }
        },
        "mounts": {
          "type": "array",
          "title": "Breadboardmontages",
          "description": "Elektrische verbindingen die ontstaan doordat componentpinnen rechtstreeks in breadboardgaten zijn geplaatst.",
          "items": {
            "type": "object",
            "title": "Gemonteerde componentpin",
            "required": [
              "componentPin",
              "breadboardPin"
            ],
            "additionalProperties": false,
            "properties": {
              "componentPin": {
                "type": "string",
                "title": "Componentpin",
                "description": "Volledige ID van de pin op het geplaatste component."
              },
              "breadboardPin": {
                "type": "string",
                "title": "Breadboardgat",
                "description": "Volledige ID van het breadboardgat waarin de componentpin is geplaatst."
              }
            }
          }
        }
      }
    }
  }
}
